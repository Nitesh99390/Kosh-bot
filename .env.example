# Get this from @BotFather
BOT_TOKEN=1234567890:AAF_YOUR_BOT_TOKEN_HERE

# Private Dump Channel ID (must start with -100, add bot as Admin with Post Messages permission)
DUMP_CHANNEL_ID=-1001234567890

# Comma-separated Telegram User IDs for /admin, /backup, /broadcast
ADMIN_IDS=123456789

# Optional tuning
DB_PATH=data/koshbox.db
INLINE_PAGE_SIZE=25
LINK_CODE_TTL_SECONDS=300
